# Claude Drive — a lone saw with every drive knob pinned. Ladder drive
# at 5, saturation near the top, tape drive at 1: the filter is asked to
# clip before it resonates, so the resonance peak spits instead of sings.
# A detuned second saw and a sub keep the bottom solid under the grit.
waveform 2
mix_saw 0
mix_pulse 0
mix_tri 0
mix_sine 0
osc2_wave 2
osc2_pitch 0
osc2_level 0.55
osc3_wave 2
osc3_pitch -12
osc3_level 0.3
detune 9
sub 0.35
circuit 0
key_track 0.5
osc_fm 0
sync 0
ring 0
glide 0.03
pulse_width 0.5
attack 0.004
decay 0.4
sustain 0.6
release 0.28
filter_env 2.4
filter_attack 0.002
filter_decay 0.33
filter_sustain 0.2
filter_release 0.3
cutoff 900
resonance 1.4
drive 5
saturation 1.8
hpf 40
volume 0.5
octave 2
noise 0.02
fuzz 0.3
spring 0.18
reverb_decay 0.5
reverb_wet 0.16
chorus_mode 0
chorus_rate 0.5
chorus_depth 0
lfo_rate 0.8
lfo_shape 0.5
lfo_pitch 0
lfo_filter 0
lfo_pwm 0
tape_wow 0.1
tape_flutter 0.05
tape_drive 1
tape_age 0.35
