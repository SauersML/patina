# Tessera — 150 bpm, F# pentatonic (F# A B C# E) over a moving bass.
# Music for phasing mallets, after Reich and Glass. About five minutes.
#
# One twelve-note marimba figure, played by two marimbas. The second
# PHASES: its notes are 0.493056 beats long instead of 0.5 (= 1/2 - 1/144),
# so over six repetitions it slides ahead by exactly one eighth, then
# snaps back to 0.5 and LOCKS. It does this three times, then drifts the
# whole way home at 0.503472 (= 1/2 + 1/288), half as fast, three shifts
# across thirty-six repetitions, and the last bars are unison again.
#
# The harmony moves only while the marimbas are locked; while they drift
# everything else sits on an F# pedal, so the phasing is the event.
#
# Polyrhythm, all against the six-beat figure:
#   bass     dotted quarters (3:2), half notes at the climax (hemiola)
#   organ    Glass additive triplets: 3 / 3+4+5+6 / 8-note waves (3:2)
#   bells    one strike every 2.5 beats (5 eighths) — realigns every 30
#   glint    a 3.5-beat (7-eighth) figure at the climax
#   breath   eighth-note chord pulses, the swell ridden on track gain
#
#   beats    0-48    BUILD     marimba 1 assembles the figure by substitution
#           48-96    UNISON    marimba 2 fades in on top of it
#           96-132   PHASE 1   drift to +1; bass pulse on F#
#          132-228   LOCK +1   breathing chords: F#m7  Dmaj9  B11  E6/9sus
#          228-264   PHASE 2   pedal; bells have entered at 180
#          264-360   LOCK +2   the organ: triplets, then the additive process
#          360-396   PHASE 3   pedal; the reed's long tones begin
#          396-492   LOCK +3   climax: half-note bass, 8-note organ waves, glint
#          492-708   RETURN    subtraction; marimba 2 walks home over 36 bars
#          708-732   UNISON    the figure, bare, as it began

bpm 150
gate 0.9
tail 14

section BUILD 0..48
section UNISON 48..96
section PHASE1 96..132
section LOCK1 132..228
section PHASE2 228..264
section LOCK2 264..360
section PHASE3 360..396
section LOCK3 396..492
section RETURN 492..708
section CODA 708..732

# --- the room --------------------------------------------------------
automate reverb_decay
0.8
automate reverb_tone
5200
automate reverb_pre
0.025
automate chorus_mode
1
automate chorus_mix
0
automate tape_wow
0.03
automate tape_flutter
0.02
automate tape_age
0.12
automate tape_drive
0.1

automate reverb_wet
0.24 R:132 0.3:96@smooth R:168 0.36:48@smooth R:48 0.3:96@smooth 0.42:120@smooth R:24

# --- the figure --------------------------------------------------------
# F#4 C#5 B4 E5 F#4 A4 C#5 B4 E5 A4 F#4 C#5 — the low F# falls on
# eighths 0, 4 and 10 (groupings 4+6+2), so every phase position lands
# the anchor somewhere new against its twin.

track m1 vel=0.72 len=0.5 patch=tessera-marimba pan=-0.5 reverb_send=0.35
# BUILD: substitution, the figure assembled a few strokes at a time
F#4 . . . F#4 . . . . . F#4 .
F#4 . . . F#4 . . . . . F#4 .
F#4 . . E5 F#4 . . . E5 . F#4 .
F#4 . . E5 F#4 . . . E5 . F#4 .
F#4 C#5 . E5 F#4 . C#5 . E5 . F#4 C#5
F#4 C#5 B4 E5 F#4 . C#5 B4 E5 . F#4 C#5
(F#4 C#5 B4 E5 F#4 A4 C#5 B4 E5 A4 F#4 C#5)x2
# 48..732: the figure, 114 times, never changing
(F#4 C#5 B4 E5 F#4 A4 C#5 B4 E5 A4 F#4 C#5)x114

track m2 vel=0.72 len=0.5 patch=tessera-marimba pan=0.5 reverb_send=0.35
R:48
# UNISON
(F#4 C#5 B4 E5 F#4 A4 C#5 B4 E5 A4 F#4 C#5)x8
# PHASE 1: 72 notes x 0.493056 = 35.5 beats (one eighth ahead)
(F#4:0.493056 C#5:0.493056 B4:0.493056 E5:0.493056 F#4:0.493056 A4:0.493056 C#5:0.493056 B4:0.493056 E5:0.493056 A4:0.493056 F#4:0.493056 C#5:0.493056)x6
# LOCK +1
(F#4 C#5 B4 E5 F#4 A4 C#5 B4 E5 A4 F#4 C#5)x16
# PHASE 2
(F#4:0.493056 C#5:0.493056 B4:0.493056 E5:0.493056 F#4:0.493056 A4:0.493056 C#5:0.493056 B4:0.493056 E5:0.493056 A4:0.493056 F#4:0.493056 C#5:0.493056)x6
# LOCK +2
(F#4 C#5 B4 E5 F#4 A4 C#5 B4 E5 A4 F#4 C#5)x16
# PHASE 3
(F#4:0.493056 C#5:0.493056 B4:0.493056 E5:0.493056 F#4:0.493056 A4:0.493056 C#5:0.493056 B4:0.493056 E5:0.493056 A4:0.493056 F#4:0.493056 C#5:0.493056)x6
# LOCK +3
(F#4 C#5 B4 E5 F#4 A4 C#5 B4 E5 A4 F#4 C#5)x16
# RETURN: 432 notes x 0.503472 = 217.5 beats (three eighths back)
(F#4:0.503472 C#5:0.503472 B4:0.503472 E5:0.503472 F#4:0.503472 A4:0.503472 C#5:0.503472 B4:0.503472 E5:0.503472 A4:0.503472 F#4:0.503472 C#5:0.503472)x36
# CODA: home
(F#4 C#5 B4 E5 F#4 A4 C#5 B4 E5 A4 F#4 C#5)x4

automate m2.gain
0 R:48 0.75:12@smooth 1:36@smooth R:228 1.2:72@smooth R:96 0.8:216@smooth 0.7:24@smooth

# The marimbas carry the piece's arc: soft at the first strokes, fullest
# at the third lock, receding as the twins walk home.
automate m1.gain
0.6 R:24 1:72@smooth R:228 1.2:72@smooth R:96 0.8:216@smooth 0.7:24@smooth

# The mallets brighten toward the climax and darken on the way home;
# both hands move together so the twins stay the same instrument.
automate m1.cutoff
850 R:24 1300:108@exp 1700:132@exp 2600:132@exp 3000:36@smooth 1500:180@exp 950:120@exp
automate m2.cutoff
850 R:24 1300:108@exp 1700:132@exp 2600:132@exp 3000:36@smooth 1500:180@exp 950:120@exp

# --- the pulse ---------------------------------------------------------
track bass vel=0.7 len=1.5 patch=tessera-bass reverb_send=0.12
>72
(F#2)x40
# LOCK +1: F#  D  B  E
((F#2)x8 (D2)x8 (B1)x8 (E2)x8)x2
# PHASE 2 pedal
(F#2)x24
# LOCK +2: D  E  A  F#
((D2)x8 (E2)x8 (A1)x8 (F#2)x8)x2
# PHASE 3 pedal
(F#2)x24
# LOCK +3: half notes, three to the figure's two bars of three
((B1:2)x6 (D2:2)x6 (E2:2)x6 (F#2:2)x6)x2
# RETURN
(F#2)x16 (D2)x16 (E2)x16 (F#2)x32
# the last word
>732 [F#1 F#2]:10@0.6

automate bass.gain
0 R:72 1.8:24@smooth R:288 2:12@smooth R:96 1.6:12@smooth R:228

# --- the breath --------------------------------------------------------
# Eighth-note chord pulses; the swell is the gain lane below, one
# twelve-beat breath per chord, silent through every phase pedal.
track breath vel=0.5 len=0.5 patch=tessera-breath reverb_send=0.5 chorus_send=0.6
>132
([F#3 C#4 E4 A4])x24
([D3 A3 C#4 E4 F#4])x24
([B2 F#3 A3 C#4 E4])x24
([E3 B3 C#4 F#4 A4])x24
([F#3 C#4 E4 A4])x24
([D3 A3 C#4 E4 F#4])x24
([B2 F#3 A3 C#4 E4])x24
([E3 B3 C#4 F#4 A4])x24
>264
([D3 A3 C#4 E4 F#4])x24
([E3 B3 C#4 F#4 A4])x24
([A2 E3 C#4 F#4 B4])x24
([F#3 C#4 E4 A4])x24
([D3 A3 C#4 E4 F#4])x24
([E3 B3 C#4 F#4 A4])x24
([A2 E3 C#4 F#4 B4])x24
([F#3 C#4 E4 A4])x24
>396
([B2 F#3 A3 C#4 E4])x24
([D3 A3 C#4 E4 F#4])x24
([E3 B3 C#4 F#4 A4])x24
([F#3 C#4 E4 A4 C#5])x24
([B2 F#3 A3 C#4 E4])x24
([D3 A3 C#4 E4 F#4])x24
([E3 B3 C#4 F#4 A4])x24
([F#3 C#4 E4 A4 C#5])x24
# RETURN: the breaths lengthen and thin
([F#3 C#4 E4 A4])x48
([D3 A3 C#4 E4 F#4])x48
([E3 B3 C#4 F#4 A4])x48
([F#3 C#4 E4 A4])x96

automate breath.gain
0.06 R:132 (0.7:6@smooth 0.06:6@smooth)x8 R:36 (0.7:6@smooth 0.06:6@smooth)x8 R:36 (0.85:6@smooth 0.07:6@smooth)x8 (0.63:12@smooth 0.04:12@smooth)x3 (0.42:24@smooth 0:24@smooth)
automate breath.cutoff
1000 R:132 1400:96@exp R:36 1800:96@exp R:36 2400:96@exp 900:120@exp

# --- the organ ---------------------------------------------------------
# Triplets against the marimba eighths. First the bare three-note cell,
# then Glass's additive process (3, 3+4, 3+4+5, 3+4+5+6), then over the
# pedal and the climax eight-note waves, which cross the figure's bar
# at a new point every time round.
track organ vel=0.6 len=0.3333333333 patch=tessera-organ pan=-0.15 reverb_send=0.3 chorus_send=0.45
>264
(D3 A3 C#4)x12
(E3 B3 C#4)x12
(A3 C#4 E4)x12
(F#3 A3 C#4)x12
(D3 A3 C#4 D3 A3 C#4 E4 D3 A3 C#4 E4 F#4 D3 A3 C#4 E4 F#4 E4)x2
(E3 B3 C#4 E3 B3 C#4 F#4 E3 B3 C#4 F#4 A4 E3 B3 C#4 F#4 A4 F#4)x2
(A3 C#4 E4 A3 C#4 E4 F#4 A3 C#4 E4 F#4 B4 A3 C#4 E4 F#4 B4 F#4)x2
(F#3 A3 C#4 F#3 A3 C#4 E4 F#3 A3 C#4 E4 F#4 F#3 A3 C#4 E4 F#4 E4)x2
# PHASE 3 pedal: the wave, on F#
(F#3 A3 C#4 E4 F#4 E4 C#4 A3)x13 F#3 A3 C#4 E4
# LOCK +3: waves on B  D  E  F#, twice
(B2 F#3 A3 C#4 E4 C#4 A3 F#3)x4 B2 F#3 A3 C#4
(D3 A3 C#4 E4 F#4 E4 C#4 A3)x4 D3 A3 C#4 E4
(E3 B3 C#4 F#4 A4 F#4 C#4 B3)x4 E3 B3 C#4 F#4
(F#3 A3 C#4 E4 F#4 E4 C#4 A3)x4 F#3 A3 C#4 E4
(B2 F#3 A3 C#4 E4 C#4 A3 F#3)x4 B2 F#3 A3 C#4
(D3 A3 C#4 E4 F#4 E4 C#4 A3)x4 D3 A3 C#4 E4
(E3 B3 C#4 F#4 A4 F#4 C#4 B3)x4 E3 B3 C#4 F#4
(F#3 A3 C#4 E4 F#4 E4 C#4 A3)x4 F#3 A3 C#4 E4

automate organ.gain
0 R:264 0.53:36@smooth R:60 0.63:36@smooth 0.74:24@smooth R:60 0:12@smooth
automate organ.cutoff
1200 R:264 1800:96@exp 2400:36@exp 3200:60@smooth 1600:36@exp

# --- the bells ---------------------------------------------------------
# One strike every five eighths: the four-bell cycle lasts ten beats,
# so it realigns with the six-beat figure only every thirty.
track bells vel=0.42 len=2.5 patch=tessera-bell pan=0.25 reverb_send=0.6
>180
(C#6 B5 E6 F#5)x48

automate bells.gain
0 R:180 1:30@smooth R:390 0:60@smooth

# Seven eighths, only at the climax: against 6 and 2.5 it never repeats
track glint vel=0.3 len=0.5 patch=tessera-bell pan=-0.35 reverb_send=0.7
>396
(E6 R:1 B6 R:1.5)x27

automate glint.gain
0 R:396 0.8:24@smooth R:48 0:22.5@smooth

# --- the reed ----------------------------------------------------------
# Long tones drawn from what the two marimbas are already making
# together: the resulting melody, slowed down until it can be sung.
track reed vel=0.55 patch=tessera-reed pan=0.1 reverb_send=0.45
>360
C#5:6 B4:6 E5:12 C#5:12
F#5:6 E5:6 A5:6 F#5:6 B5:12 C#5:12
E5:6 F#5:6 C#6:12 B5:6 A5:6 F#5:12
C#5:12 B4:12 A4:24 B4:12 E5:12 C#5:24

automate reed.gain
0 R:360 0.4:12@smooth 0.5:24@smooth R:156 0:60@smooth
automate reed.cutoff
1100 R:360 1600:36@exp 2200:96@exp 1000:120@exp
