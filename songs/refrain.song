# ----------------------------------------------------------------- pads

track pads vel=0.5 patch=init gain=0.5 reverb_send=0.28
R:1
# 18 loops; L' (Cb for Ebm) at loops 6, 9, 11, 15
([Bb3 Db4 F4]:6 [Ab3 Db4 F4]:6 [Gb3 Bb3 Db4 F4]:6 [Gb3 Ab3 Db4 Eb4]:6)x5
[Bb3 Db4 F4]:6 [Ab3 Db4 F4]:6 [Gb3 Bb3 Eb4 F4]:6 [Gb3 Ab3 Db4 Eb4]:6
([Bb3 Db4 F4]:6 [Ab3 Db4 F4]:6 [Gb3 Bb3 Db4 F4]:6 [Gb3 Ab3 Db4 Eb4]:6)x2
[Bb3 Db4 F4]:6 [Ab3 Db4 F4]:6 [Gb3 Bb3 Eb4 F4]:6 [Gb3 Ab3 Db4 Eb4]:6
[Bb3 Db4 F4]:6 [Ab3 Db4 F4]:6 [Gb3 Bb3 Db4 F4]:6 [Gb3 Ab3 Db4 Eb4]:6
[Bb3 Db4 F4]:6 [Ab3 Db4 F4]:6 [Gb3 Bb3 Eb4 F4]:6 [Gb3 Ab3 Db4 Eb4]:6
([Bb3 Db4 F4]:6 [Ab3 Db4 F4]:6 [Gb3 Bb3 Db4 F4]:6 [Gb3 Ab3 Db4 Eb4]:6)x3
[Bb3 Db4 F4]:6 [Ab3 Db4 F4]:6 [Gb3 Bb3 Eb4 F4]:6 [Gb3 Ab3 Db4 Eb4]:6
([Bb3 Db4 F4]:6 [Ab3 Db4 F4]:6 [Gb3 Bb3 Db4 F4]:6 [Gb3 Ab3 Db4 Eb4]:6)x2
[Bb3 Db4 F4]:6 [Ab3 Db4 F4]:6 [Gb3 Bb3 Db4 F4]:6 [Gb3 Ab3 Db4 Eb4]:5
