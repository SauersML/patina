# Buses — 124 bpm, D minor. A demo of group buses and the bus FX lanes:
# a pad, a bass and a lead on one bus (`bus music`), the kit on its own,
# and the whole mix (`bus mix`).
#
#   beats  0-16   GROOVE  the music bus pumps off the kick (duck_from)
#   beats 16-24   GATE    the music bus chops on a sixteenth-step gate
#                         while the drums play straight through
#   beats 24-28   ROLL    the music bus rolls: a 1/16 beat repeat that
#                         halves every half beat (16ths, 32nds, 64ths)
#   beats 28-32   CUT     the whole mix gated for a bar, rooms and all
#   beats 32-36   STOP    the deck loses power on a front-loaded curve

bpm 124
gate 0.9
tail 1

section GROOVE 0..16
section GATE 16..24
section ROLL 24..28
section CUT 28..32
section STOP 32..36

automate reverb_wet
0.15
automate reverb_decay
0.55

track kick kit=909 gain=1.1
(BD BD BD BD)x8 | BD BD BD BD

track hats kit=kick len=0.5
(R CH R CH R CH R OH)x9

track pad patch=dreampad vel=0.6 reverb_send=0.3
([D3 F3 A3 C4]:4 [A#2 D3 F3 A3]:4 [F2 A2 C3 E3]:4 [C3 E3 G3 A#3]:4)x2 | [D3 F3 A3 C4]:4

track bass patch=deepsine vel=0.9
(D2:0.75 R:0.25 D2:0.5 D3:0.5 R:0.5 D2:0.5 C2:1 | A#1:0.75 R:0.25 A#1:0.5 A#2:0.5 R:0.5 A#1:0.5 C2:1 | F1:0.75 R:0.25 F1:0.5 F2:0.5 R:0.5 F1:0.5 G1:1 | C2:0.75 R:0.25 C2:0.5 C3:0.5 R:0.5 C2:0.5 A#1:1)x2 | D2:4

track lead patch=glasslead vel=0.7 len=0.5 reverb_send=0.2
>8 A4 C5 D5 F5 E5 D5 C5 A4 | A#4 D5 F5 A5 G5 F5 D5 A#4 | A4 C5 E5 G5 F5 E5 C5 A4 | G4 A#4 C5 E5 D5 C5 A#4 G4
A4 C5 D5 F5 E5 D5 C5 A4 | A#4 D5 F5 A5 G5 F5 D5 A#4 | A4:4 | R:4 | D5:4

# the music bus: ducked off every kick, gated in GATE, rolled in ROLL
bus music tracks=pad,bass,lead duck=0.6 duck_from=kick.BD duck_release=0.09 shape=xx.x.xx.x.xx.x.x. shape_depth=0
automate music.shape_depth
0 >GATE 1 >GATE.end 0
automate music.stutter
0 >ROLL 16 >ROLL.end 0
automate music.stutter_halve
0.5

# the whole mix: a bar of gate, then a curved tape stop
bus mix shape=x.xx.x.xx.xxx.x.. shape_depth=0
automate mix.shape_depth
0 >CUT 1 >CUT.end 0
automate mix.tape_stop_curve
1.6
automate mix.tape_stop
0 >STOP 3
