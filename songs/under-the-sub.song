# Under the Sub — 140 bpm, A minor. A demo for `patina feel`: a still
# intro the ground can't feel, the kick on every beat, a held bass
# under the kicks, a silent break, and a drop with the kick 6 dB harder.
#
#   beats   0-16   INTRO  pad and hats only: still
#   beats  16-48   KICK   the 909 kick on every beat (0.4286 s apart)
#   beats  48-80   BASS   + a held sine bass, A1 F1 C2 G1, humming between kicks
#   beats  80-88   BREAK  silence
#   beats  88-120  DROP   the kick at gain 2 (+6 dB), the bass back
#   beats 120-128  OUTRO  the pad alone
#
#   patina feel songs/under-the-sub.song                 # buried in a festival field
#   patina feel songs/under-the-sub.song --venue house   # in a boomy timber floor

bpm 140
gate 0.95
tail 3

section INTRO 0..16
section KICK 16..48
section BASS 48..80
section BREAK 80..88
section DROP 88..120
section OUTRO 120..128

automate reverb_wet
0.15

track kick kit=909
>16 (BD BD BD BD)x16
>88 (BD BD BD BD)x8

automate kick.gain
1 >88 2

track hats kit=909 gain=0.8
(R:0.5 CH:0.5)x80
>88 (R:0.5 CH:0.5)x32

track bass patch=deepsine vel=0.8 gain=0.9
>48 A1:8 F1:8 C2:8 G1:8
>88 A1:8 F1:8 C2:8 G1:8

track pad patch=aurora vel=0.5 gain=0.7 reverb_send=0.3
[A3 C4 E4]:8 [F3 A3 C4]:8
>120 [A3 C4 E4]:8
