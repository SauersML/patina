# ------------------------------------------------------------------ pads

track pads vel=0.5 patch=init gain=0.5 reverb_send=0.4
R:1
# INTRO + A1 + A2: the loop five times
([Bb3 Db4 F4]:6 [Ab3 Db4 F4]:6 [Gb3 Bb3 Db4 F4]:6 [Gb3 Ab3 Db4 Eb4]:6)x5
# B
[Ab3 C4 Db4 F4]:6 [Bb3 Db4 F4]:6 [Gb3 Bb3 Eb4 F4]:6 [Gb3 Ab3 Db4 Eb4]:6
[Ab3 C4 Db4 F4]:6 [Bb3 Db4 F4]:6 [Gb3 Bb3 Db4 F4]:6 [Gb3 Ab3 Db4 Eb4]:6
# A3
([Bb3 Db4 F4]:6 [Ab3 Db4 F4]:6 [Gb3 Bb3 Db4 F4]:6 [Gb3 Ab3 Db4 Eb4]:6)x2
# coda
[Bb3 Db4 F4]:6 [Ab3 Db4 F4]:6 [Gb3 Bb3 Db4 F4]:6 [Gb3 Ab3 Db4 Eb4]:6 [Bb3 Db4 F4]:5
